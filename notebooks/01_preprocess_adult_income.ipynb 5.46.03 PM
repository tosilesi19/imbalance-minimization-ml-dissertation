     ]
    }
   ],
   "source": [
    "adult[\"target\"] = (adult[\"income\"] == \">50K\").astype(int)\n",
    "adult = adult.drop(columns=[\"income\"])\n",
    "print(adult[\"target\"].value_counts(normalize=True))   # expect ~0.24 positive"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "04c93edf-01c3-4939-9e16-a5e9015467d0",
   "metadata": {},
   "source": [
    "## Drop decisions, Adult\n",
    "\n",
    "- fnlwgt: census sampling weight, not a person-level attribute\n",
    "- education: fully redundant with ordinal education_num\n",
    "- native_country: sparse categorical\n",
    "- relationship: proxy attribute\n",
    "- sex (raw): replaced by explicit binary sex_female before encoding"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "ec439c72-796b-439f-8259-893962e21794",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(32561, 11)\n"
     ]
    }
   ],
   "source": [
    "drop_cols = [\"fnlwgt\", \"education\", \"native_country\", \"relationship\"]\n",
    "adult = adult.drop(columns=drop_cols)\n",
    "print(adult.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0ebce8e8-f29d-4c66-b05f-7c775d3dc482",
   "metadata": {},
   "source": [
    "## Fairness attribute construction\n",
    "\n",
    "`sex_female` is built as an explicit binary column BEFORE one-hot\n",
    "encoding so it can never be silently lost or renamed. It is the sole protected attribute in the design and is\n",
    "protected from removal throughout the pipeline."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "5378e97a-aeca-43e9-947c-776693386955",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "sex_female\n",
      "0    0.669205\n",
      "1    0.330795\n",
      "Name: proportion, dtype: float64\n"
     ]
    }
   ],
   "source": [
    "adult[\"sex_female\"] = (adult[\"sex\"] == \"Female\").astype(int)\n",
    "adult = adult.drop(columns=[\"sex\"])\n",
    "print(adult[\"sex_female\"].value_counts(normalize=True))   # ~0.33 female"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "a4a8715a-c664-413d-8140-9bbd1ad5865a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Encoding: ['workclass', 'marital_status', 'occupation', 'race']\n",
      "(32561, 43)\n"
     ]
    }
   ],
   "source": [
    "cat_cols = adult.select_dtypes(include=\"object\").columns.tolist()\n",
    "print(\"Encoding:\", cat_cols)   # workclass, marital_status, occupation, race\n",
    "\n",
    "adult = pd.get_dummies(adult, columns=cat_cols, dtype=int)\n",
    "print(adult.shape)"
   ]
